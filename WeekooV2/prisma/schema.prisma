generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Player record. discordId is the natural key — no separate internal id,
// mirrors how V1 kept discord_id as the primary identifier across tables.
model User {
  discordId       String    @id
  username        String
  description     String    @default("No description set.")
  weekoins        Int       @default(0)
  xp              Int       @default(0)
  level           Int       @default(1)
  energy          Int       @default(100)
  lastEnergyReset DateTime  @default(now())

  // Base combat stats before equipment bonuses.
  baseDamage      Int       @default(10)
  baseDefense     Int       @default(0)
  baseLuck        Int       @default(1)
  baseMagicDamage Int       @default(0)
  baseHp          Int       @default(100)

  birthdayDay     Int?
  birthdayMonth   Int?

  lastDaily       DateTime?
  streak          Int       @default(0)

  // True while an /adventure session is active — shop/buy/sell/sellall check
  // this and refuse to run so inventory/coins can't shift mid-session.
  inAdventure     Boolean   @default(false)

  weaponId        String?
  pickaxeId       String?
  armorId         String?
  trinketId       String?
  dimensionId     String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  weapon          Item?      @relation("UserWeapon", fields: [weaponId], references: [id])
  pickaxe         Item?      @relation("UserPickaxe", fields: [pickaxeId], references: [id])
  armor           Item?      @relation("UserArmor", fields: [armorId], references: [id])
  trinket         Item?      @relation("UserTrinket", fields: [trinketId], references: [id])
  dimension       Dimension? @relation(fields: [dimensionId], references: [id])
  inventory       Inventory[]
}

// Normalized item categories — a fixed, DB-enforced set instead of a free
// string, so an item can never end up with a typo'd or nonexistent type.
model ItemType {
  id        String   @id @default(cuid())
  name      String   @unique // "weapon" | "pickaxe" | "armor" | "trinket" | "material" | "block" | "consumable"
  createdAt DateTime @default(now())

  items Item[]
}

// statModifierType (trinkets only): "damage" | "defense" | "luck" | "health" — percentage modifier
model Item {
  id               String   @id @default(cuid())
  name             String   @unique
  emoji            String   @default("❔")
  itemTypeId       String
  mainStatValue    Int      @default(0)
  statModifierType String?
  price            Int      @default(0)
  description      String   @default("")
  rarity           String   @default("Common")
  isLocked         Boolean  @default(false)
  // False = exists and ownable/sellable, but never appears in /shop or is
  // buyable via /buy — for drop-only items (adventure loot, quest rewards, etc).
  shopItem         Boolean  @default(true)
  maxInventory     Int      @default(64)
  createdAt        DateTime @default(now())

  itemType          ItemType     @relation(fields: [itemTypeId], references: [id])
  inventories       Inventory[]
  equippedAsWeapon  User[]       @relation("UserWeapon")
  equippedAsPickaxe User[]       @relation("UserPickaxe")
  equippedAsArmor   User[]       @relation("UserArmor")
  equippedAsTrinket User[]       @relation("UserTrinket")
  enemyLootEntries  EnemyLoot[]
  miningLootEntries MiningLoot[]
}

model Inventory {
  id       String @id @default(cuid())
  userId   String
  itemId   String
  quantity Int    @default(1)

  user User @relation(fields: [userId], references: [discordId])
  item Item @relation(fields: [itemId], references: [id])

  @@unique([userId, itemId])
}

model Dimension {
  id           String  @id @default(cuid())
  name         String  @unique
  emoji        String  @default("🌍")
  // Chance [0-1] of a monster encounter per adventure action taken here.
  battleChance Float   @default(0.25)

  users       User[]
  enemies     Enemy[]
  miningLoot  MiningLoot[]
}

// A monster that can be encountered while adventuring in a dimension.
model Enemy {
  id          String @id @default(cuid())
  name        String @unique
  imageUrl    String @default("")
  hp          Int
  damage      Int
  defense     Int
  xpDrop      Int    @default(0)
  dimensionId String

  dimension Dimension   @relation(fields: [dimensionId], references: [id])
  lootTable EnemyLoot[]
}

// One possible drop from defeating an enemy — rolled independently per entry,
// so a single kill can drop multiple things (or nothing beyond guaranteed XP).
model EnemyLoot {
  id      String @id @default(cuid())
  enemyId String
  itemId  String
  chance  Float // 0-1
  minQty  Int   @default(1)
  maxQty  Int   @default(1)

  enemy Enemy @relation(fields: [enemyId], references: [id])
  item  Item  @relation(fields: [itemId], references: [id])

  @@unique([enemyId, itemId])
}

// One possible drop from a mining action in a dimension (blocks/ores, not combat loot).
model MiningLoot {
  id          String @id @default(cuid())
  dimensionId String
  itemId      String
  chance      Float // 0-1, before luck bonus
  minQty      Int    @default(1)
  maxQty      Int    @default(1)

  dimension Dimension @relation(fields: [dimensionId], references: [id])
  item      Item      @relation(fields: [itemId], references: [id])

  @@unique([dimensionId, itemId])
}
