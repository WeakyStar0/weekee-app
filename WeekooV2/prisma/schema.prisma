generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  discordId String   @unique
  coins     Int      @default(0)
  xp        Int      @default(0)
  level     Int      @default(1)
  energy    Int      @default(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
